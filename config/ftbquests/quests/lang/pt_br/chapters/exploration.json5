  "quest.1D96D2FF800AE80A.quest_desc": [
    "Os templos oceânicos de Moog ficam no fundo de mares profundos. A sala do tesouro contém um Coração do Mar uma vez a cada quatro.",
  ],
  "quest.7063420D36849583.title": "&aIlha das Sereias",
  "quest.46EEC36A2FA7A0D0.quest_desc": [
    "Ilhas de árvores encantadas e cogumelos gigantes, bem longe no oceano profundo.",
